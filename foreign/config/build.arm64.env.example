# Source this file or copy it to foreign/config/local.env and edit there.
# Do not commit local.env.

# Required for target builds.
export NDK=/opt/android-ndk
export DSGSI_ROOTFS=/absolute/path/to/dsgsi/staging/root

# Android 12 target baseline.
export API=31
export AOSP_TAG=android-12.0.0_r8

# Optional: point quarry/output somewhere else inside the repository.
# export QUARRY_DIR="$PWD/quarry/aosp-android-12.0.0_r8"
# export OUT_DIR="$PWD/out/foreign/arm64"

# Optional: if the DSGSI staging rootfs does not carry libcap.so,
# supply a target arm64 Android libcap static archive.
# export INNIT_LIBCAP_A=/absolute/path/to/libcap.a

# Optional: fallback if /system/lib64/libgsi.so is absent.
export INNIT_ALLOW_GSI_STUB=1
export INNIT_ASSUME_GSI_RUNNING=1

# Optional extension points.
# export INNIT_EXTRA_INCLUDE_DIRS=/path/a/include:/path/b/include
# export INNIT_EXTRA_LIB_DIRS=/path/a/lib64:/path/b/lib64
# export INNIT_EXTRA_LDLIBS="-lfoo -lbar"
